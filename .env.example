# Copy to .env.local and fill in. Never commit real values.

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# AI document reading and rule drafting (server only, never prefix with NEXT_PUBLIC_).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. Defaults to gemini-3.8-flash (free tier, most accurate).
GEMINI_MODEL=
# Optional. Used automatically when the main model is busy. Defaults to gemini-2.5-flash-lite.
GEMINI_FALLBACK_MODEL=
